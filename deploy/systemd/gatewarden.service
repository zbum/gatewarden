[Unit]
Description=Gatewarden SSH failure blocker
Documentation=https://github.com/zbum/gatewarden
After=network-online.target ssh.service sshd.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/gatewarden/gatewarden.env
ExecStart=/usr/bin/gatewarden
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=gatewarden
RuntimeDirectory=gatewarden
# CAP_PERFMON is its own line. A systemd that does not know the name ignores the whole assignment.
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN
CapabilityBoundingSet=CAP_PERFMON
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN
AmbientCapabilities=CAP_PERFMON
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
