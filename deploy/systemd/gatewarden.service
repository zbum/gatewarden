[Unit]
Description=Gatewarden SSH failure blocker
Documentation=https://github.com/zbum/gatewarden
After=network.target ssh.service

[Service]
Type=simple
ExecStart=/usr/bin/gatewarden -journal-unit ssh -threshold 5 -window 5m -ban-duration 15m
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
