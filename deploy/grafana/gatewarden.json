{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus that scrapes gatewarden",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "table", "name": "Table", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "OpenSSH 인증 실패로 차단된 주소. 누적 카운터는 gatewarden 프로세스가 다시 시작되면 0부터 셉니다. 영구 차단은 재시작 후에도 유지됩니다.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "임시 차단과 영구 차단을 합친 수입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_blocked_current{job=~\"$job\"}) or vector(0)",
          "legendFormat": "blocked",
          "refId": "A"
        }
      ],
      "title": "지금 차단",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "만료 시각이 있는 차단입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "orange", "value": 10}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "clamp_min((sum(gatewarden_blocked_current{job=~\"$job\"}) or vector(0)) - (sum(gatewarden_permanent_current{job=~\"$job\"}) or vector(0)), 0)",
          "legendFormat": "temporary",
          "refId": "A"
        }
      ],
      "title": "임시 차단",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "만료 없이 유지되는 주소입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_permanent_current{job=~\"$job\"}) or vector(0)",
          "legendFormat": "permanent",
          "refId": "A"
        }
      ],
      "title": "영구 차단",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "최근 5분 동안 집계된 인증 실패의 분당 수입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 1,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 30}
            ]
          },
          "unit": "cpm"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "(sum(rate(gatewarden_failures_total{job=~\"$job\"}[5m])) or vector(0)) * 60",
          "legendFormat": "failures",
          "refId": "A"
        }
      ],
      "title": "실패 / 분",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "영구 차단은 지금 차단에 포함됩니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "영구"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "전체"},
            "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 4},
      "id": 5,
      "options": {
        "legend": {"calcs": ["last", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_blocked_current{job=~\"$job\"})",
          "legendFormat": "전체",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_permanent_current{job=~\"$job\"})",
          "legendFormat": "영구",
          "refId": "B"
        }
      ],
      "title": "차단 수",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "최근 5분 평균입니다. 프로세스가 다시 시작되면 카운터가 리셋됩니다. 만료는 임시 차단이 끝난 횟수입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "min": 0,
          "unit": "cpm"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 4},
      "id": 6,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(gatewarden_failures_total{job=~\"$job\"}[5m])) * 60",
          "legendFormat": "실패",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(gatewarden_blocks_total{job=~\"$job\"}[5m])) * 60",
          "legendFormat": "신규 차단",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(gatewarden_unblocks_total{job=~\"$job\"}[5m])) * 60",
          "legendFormat": "만료",
          "refId": "C"
        }
      ],
      "title": "분당 사건",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "만료가 가까운 주소가 위에 옵니다.",
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}, "mappings": []},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "displayName", "value": "만료"},
              {"id": "unit", "value": "dateTimeFromNow"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "ip"},
            "properties": [{"id": "displayName", "value": "IP"}]
          },
          {
            "matcher": {"id": "byName", "options": "instance"},
            "properties": [{"id": "displayName", "value": "대상"}]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 12},
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{"desc": false, "displayName": "만료"}]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "gatewarden_block_until_seconds{job=~\"$job\"} * 1000",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "임시 차단 목록",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true},
            "indexByName": {"ip": 0, "instance": 1, "Value": 2},
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "이 주소는 차단 시간이 끝나도 풀리지 않습니다.",
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}, "mappings": []},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "ip"},
            "properties": [{"id": "displayName", "value": "IP"}]
          },
          {
            "matcher": {"id": "byName", "options": "instance"},
            "properties": [{"id": "displayName", "value": "대상"}]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 10, "x": 14, "y": 12},
      "id": 8,
      "options": {"cellHeight": "sm", "showHeader": true, "sortBy": [{"desc": false, "displayName": "IP"}]},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "gatewarden_permanent{job=~\"$job\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "영구 차단 목록",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true},
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "이 프로세스가 시작한 뒤 집계한 인증 실패입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 21},
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_failures_total{job=~\"$job\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "시작 이후 실패",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "이 프로세스가 시작한 뒤 적용한 차단입니다. 영구 차단으로 바뀐 건도 포함합니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 21},
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_blocks_total{job=~\"$job\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "시작 이후 차단",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "임시 차단이 시간이 지나 풀린 횟수입니다. 수동 해제와 종료 시 정리는 포함하지 않습니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 21},
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(gatewarden_unblocks_total{job=~\"$job\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "시작 이후 만료",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "지금 열려 있는 SSH 세션입니다. 사용자, 출발지, 클라이언트 포트, 접속 시각을 보고 예상 밖 접속을 확인합니다.",
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}, "mappings": []},
        "overrides": [
          {"matcher": {"id": "byName", "options": "user"}, "properties": [{"id": "displayName", "value": "사용자"}]},
          {"matcher": {"id": "byName", "options": "ip"}, "properties": [{"id": "displayName", "value": "출발지"}]},
          {"matcher": {"id": "byName", "options": "port"}, "properties": [{"id": "displayName", "value": "포트"}]},
          {"matcher": {"id": "byName", "options": "instance"}, "properties": [{"id": "displayName", "value": "대상"}]},
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "displayName", "value": "접속 시각"}, {"id": "unit", "value": "dateTimeAsIso"}]}
        ]
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 25},
      "id": 12,
      "options": {"cellHeight": "sm", "showHeader": true, "sortBy": [{"desc": true, "displayName": "접속 시각"}]},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "gatewarden_session_since_seconds{job=~\"$job\"} * 1000",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "접속 중인 SSH",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true},
            "indexByName": {"user": 0, "ip": 1, "port": 2, "instance": 3, "Value": 4},
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    }
