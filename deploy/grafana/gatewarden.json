  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["gatewarden", "ssh"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "gatewarden", "value": "gatewarden"},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(gatewarden_blocked_current, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": {"query": "label_values(gatewarden_blocked_current, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
